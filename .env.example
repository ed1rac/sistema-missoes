# Variáveis de ambiente para implantação em Docker (Linux)
# Copie para .env e substitua JWT_SECRET antes de iniciar em produção:
#   cp .env.example .env

PORT=5179
HOST=0.0.0.0
UVICORN_RELOAD=false
TZ=America/Sao_Paulo
DEFAULT_DAILY_ALLOWANCE=425.00

# Gere um segredo aleatório forte (ex.: openssl rand -hex 32)
JWT_SECRET=ALTERE_ESTE_SEGREDO_PARA_PRODUCAO_COM_CHAVE_ALEATORIA_FORTE
